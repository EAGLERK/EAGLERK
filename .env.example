# Copy to .env.local. Leave the two Supabase values empty to run in browser-only mode (no accounts).
# Only the public "anon" key belongs here. Never put the service_role key in front-end code.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Set to 0 to hide the "Continue with Google" button.
VITE_AUTH_GOOGLE=1

# Mobile-number sign-in. Turn on (1) only after an SMS provider is configured in Supabase.
VITE_AUTH_PHONE=0
