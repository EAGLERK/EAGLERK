        "$value": "0.32s"
      },
      "follow": {
        "$type": "duration",
        "$value": "0.3s"
      }
    },
    "easing": {
      "out": {
        "$value": "power3.out",
        "$description": "GSAP ease name (src/motion/index.ts). Not converted to cubic-bezier: GSAP's polynomial eases are not exact beziers."
      },
      "in": {
        "$value": "power2.in",
        "$description": "GSAP ease name (src/motion/index.ts). Not converted to cubic-bezier: GSAP's polynomial eases are not exact beziers."
      },
      "settle": {
        "$value": "back.out(2)",
        "$description": "GSAP ease name (src/motion/index.ts). Not converted to cubic-bezier: GSAP's polynomial eases are not exact beziers."
      },
      "soft": {
        "$value": "power1.out",
        "$description": "GSAP ease name (src/motion/index.ts). Not converted to cubic-bezier: GSAP's polynomial eases are not exact beziers."
      }
    }
