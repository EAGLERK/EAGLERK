    "shadow": {
      "xs": {
        "$type": "shadow",
        "$value": [
          {
            "color": "rgb(0 0 0 / 0.05)",
            "offsetX": "0",
            "offsetY": "1px",
            "blur": "2px",
            "spread": "0"
          }
        ]
      },
      "sm": {
        "$type": "shadow",
        "$value": [
          {
            "color": "rgb(0 0 0 / 0.1)",
            "offsetX": "0",
            "offsetY": "1px",
            "blur": "3px",
            "spread": "0"
          },
          {
            "color": "rgb(0 0 0 / 0.1)",
            "offsetX": "0",
            "offsetY": "1px",
            "blur": "2px",
            "spread": "-1px"
          }
        ]
      },
      "md": {
        "$type": "shadow",
        "$value": [
          {
            "color": "rgb(0 0 0 / 0.1)",
            "offsetX": "0",
            "offsetY": "10px",
            "blur": "15px",
            "spread": "-3px"
          },
          {
            "color": "rgb(0 0 0 / 0.1)",
