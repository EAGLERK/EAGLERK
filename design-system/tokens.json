          "letterSpacing": "normal"
        },
        "$description": "Field labels, table heads, buttons, tabs, sidebar links."
      },
      "meta": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{primitive.font.family.system}",
          "fontSize": "{primitive.font.size.meta}",
          "fontWeight": "{primitive.font.weight.regular}",
          "lineHeight": 1.5,
          "letterSpacing": "normal"
        },
        "$description": "Hints, notes, secondary lines (text.secondary or text.muted)."
      },
      "caption": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{primitive.font.family.system}",
          "fontSize": "{primitive.font.size.caption}",
          "fontWeight": "{primitive.font.weight.regular}",
          "lineHeight": 1.4,
          "letterSpacing": "normal"
        },
        "$description": "Chart ticks and legends only."
      }
    },
    "elevation": {
      "card": {
        "$type": "shadow",
        "$value": "{primitive.shadow.sm}",
        "$description": "Resting cards, segmented active segment."
      },
      "control": {
        "$type": "shadow",
        "$value": "{primitive.shadow.xs}",
        "$description": "Outline buttons and inputs."
      },
      "overlay": {
        "$type": "shadow",
        "$value": "{primitive.shadow.md}",
        "$description": "Dialogs, popovers, toasts."
      },
      "tour": {
        "$type": "shadow",
        "$value": "{primitive.shadow.lg}",
        "$description": "The first-time tour popover."
      },
      "focus-ring": {
        "$description": "Focus: the border turns accent and this ring appears (CSS --ring-soft).",
        "$value": "0 0 0 3px color-mix(in srgb, var(--accent) 35%, transparent)",
        "$extensions": {
          "mymoney": {
            "css": "--ring-soft",
            "note": "Not a DTCG shadow: it mixes with the live accent colour, so it stays a CSS string."
          }
        }
      }
    },
    "motion": {
      "instant": {
        "$description": "Press feedback. Scale to 0.97 (buttons, choices), 0.985 (sidebar rows), 0.94 (tabs).",
        "duration": "{primitive.duration.instant}",
        "easing": "{primitive.easing.out}",
        "properties": "transform",
        "reducedMotion": "skipped: end state set at once"
      },
      "micro": {
        "$description": "Hover tint via --hv.",
        "duration": "{primitive.duration.micro}",
        "easing": "{primitive.easing.soft}",
        "properties": "--hv",
        "reducedMotion": "skipped"
      },
      "enter": {
        "$description": "Toast in (opacity, y 10), popovers (opacity, scale 0.98, y 6).",
        "duration": "{primitive.duration.enter}",
        "easing": "{primitive.easing.out}",
        "properties": "opacity, transform",
        "reducedMotion": "skipped: element appears in place"
      },
      "exit": {
        "$description": "Toast out (opacity, y 6). Shorter than enter.",
        "duration": "{primitive.duration.exit}",
        "easing": "{primitive.easing.in}",
        "properties": "opacity, transform",
        "reducedMotion": "skipped: removed immediately"
      },
      "overlay": {
        "$description": "Dialog in: from opacity 0, scale 0.97, y 12; backdrop via --bd.",
        "duration": "{primitive.duration.enter}",
        "easing": "{primitive.easing.out}",
        "properties": "opacity, transform, --bd",
        "reducedMotion": "skipped: dialog appears in place"
      },
      "release": {
        "$description": "Press release with a small settle. Routine surfaces only.",
        "duration": "0.22s",
        "easing": "{primitive.easing.settle}",
        "properties": "transform",
        "reducedMotion": "skipped"
      },
      "route": {
        "$description": "Screen change: opacity only, so nothing shifts under a reaching finger.",
        "duration": "{primitive.duration.route}",
        "easing": "{primitive.easing.soft}",
        "properties": "opacity",
        "reducedMotion": "skipped"
      },
      "cascade": {
        "$description": "Summary cards arrive in turn, once per visit. Stagger 0.06s.",
        "duration": "{primitive.duration.cascade}",
        "easing": "{primitive.easing.soft}",
        "properties": "opacity",
        "reducedMotion": "skipped"
      },
      "follow": {
        "$description": "The tour ring gliding to its next target.",
        "duration": "{primitive.duration.follow}",
        "easing": "{primitive.easing.out}",
        "properties": "left, top, width, height",
        "reducedMotion": "jumps to the target"
      },
      "loader": {
        "$description": "Mitra listening: the ring breathes (--pulse, 0.8s sine, yoyo) and five bars rise and fall (0.45 to 0.69s sine).",
        "duration": "0.8s",
        "easing": "sine.inOut",
        "properties": "--pulse, transform",
        "reducedMotion": "still ring, still bars"
      }
    }
  }
}