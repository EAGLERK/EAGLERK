{
  "name": "mymoney",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:single": "node scripts/build-single.mjs",
    "e2e": "node e2e/flow.cjs",
    "e2e:auth": "node e2e/auth.cjs",
    "e2e:welcome": "node e2e/welcome.cjs",
    "e2e:edit": "node e2e/edit.cjs",
    "e2e:notes": "node e2e/notes.cjs",
    "e2e:voice": "node e2e/voice.cjs",
    "e2e:voice-ai": "node e2e/voice-ai.cjs",
    "e2e:pwa": "node e2e/pwa.cjs",
    "e2e:sheets": "node e2e/sheets.cjs",
    "dev:auth-demo": "node scripts/dev-auth-demo.cjs",
    "check:supabase": "node scripts/check-supabase.cjs",
    "e2e:ui": "node e2e/ui.cjs",
    "build:mobile": "vite build --base ./ && cap sync",
    "mobile:android": "npm run build:mobile && cap open android",
    "mobile:ios": "npm run build:mobile && cap open ios",
    "mobile:apk": "npm run build:mobile && cd android && ./gradlew assembleDebug",
    "mobile:icons": "capacitor-assets generate --assetPath assets --android --ios",
    "design:build": "node scripts/build-design-system.mjs",
    "design:measure": "node scripts/measure-design-system.cjs"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@supabase/supabase-js": "^2.118.0",
    "gsap": "3.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@electric-sql/pglite": "^0.5.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
